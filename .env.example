# Copy this file to .env and adjust. NEVER commit .env (it is git-ignored).
# Docker Compose reads .env automatically. All values below are DEVELOPMENT
# defaults - use strong, unique secrets for any shared or production setup.

# --- Application ---
FLASK_DEBUG=0
PORT=5000
# Host port that Docker Compose publishes the app on (http://localhost:5000)
APP_PORT=5000

# --- PostgreSQL (used by docker compose) ---
POSTGRES_DB=sokoprice
POSTGRES_USER=sokoprice
POSTGRES_PASSWORD=change_me_please

# --- Running WITHOUT Docker (python run.py) ---
# The database is optional. Leave DATABASE_URL unset to run without it, or point
# it at any PostgreSQL server to record USSD requests:
# DATABASE_URL=postgresql://sokoprice:change_me_please@localhost:5432/sokoprice

# --- Future integrations (placeholders only - do not put real keys here) ---
AT_USERNAME=sandbox
AT_API_KEY=changeme
