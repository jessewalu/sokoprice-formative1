# Managed by Ansible (role security). Do not edit by hand.
# This drop-in is read before the distribution defaults, so these values win.
Port {{ security_ssh_port }}
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
PermitEmptyPasswords no
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
MaxAuthTries {{ security_ssh_max_auth_tries }}
LoginGraceTime {{ security_ssh_login_grace_time }}
ClientAliveInterval {{ security_ssh_client_alive_interval }}
ClientAliveCountMax {{ security_ssh_client_alive_count_max }}
AllowUsers {{ security_ssh_allow_users | join(' ') }}
LogLevel VERBOSE
