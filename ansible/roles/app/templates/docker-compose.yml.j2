# Managed by Ansible (role app). Do not edit by hand.
# The database is a managed Amazon RDS instance, so only the application runs here.
name: sokoprice

services:
  app:
    image: {{ app_image }}
    restart: unless-stopped
    env_file: .env
    ports:
      - "{{ app_public_port }}:{{ app_container_port }}"
    init: true
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    logging:
{% if app_log_group | length > 0 %}
      driver: awslogs
      options:
        awslogs-region: "{{ app_log_region }}"
        awslogs-group: "{{ app_log_group }}"
        awslogs-stream: "{{ inventory_hostname }}"
        awslogs-create-group: "false"
        mode: non-blocking
        max-buffer-size: 4m
{% else %}
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% endif %}
