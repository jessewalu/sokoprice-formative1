# -----------------------------------------------------------------------------
# Database module: managed PostgreSQL (Amazon RDS).
#
#   * Runs in the private subnets; not publicly accessible; only the application
#     server's security group can connect.
#   * Encrypted at rest, TLS required for every connection (rds.force_ssl).
#   * The password is generated by Terraform (never typed or committed) and is
#     stored in AWS Secrets Manager, encrypted with a customer-managed KMS key.
#     The deployment pipeline reads it from there at deploy time.
#   * Automated backups, minor-version upgrades, enhanced monitoring, and
#     PostgreSQL logs exported to CloudWatch.
# -----------------------------------------------------------------------------

data "aws_caller_identity" "current" {}

data "aws_partition" "current" {}

# ------------------------------- Secret --------------------------------------

data "aws_iam_policy_document" "secret_kms" {
  #checkov:skip=CKV_AWS_109:Standard KMS key policy. The account root statement is required so that IAM can administer the key; without it the key becomes unmanageable.
  #checkov:skip=CKV_AWS_111:Same statement as CKV_AWS_109. Which roles may use the key is controlled by IAM policies (the deployment role) and by the kms:ViaService condition on them.
  #checkov:skip=CKV_AWS_356:In a key policy the resource "*" always means "this key", so it cannot be narrowed further.
  statement {
    sid       = "EnableAccountAdministration"
    effect    = "Allow"
    actions   = ["kms:*"]
    resources = ["*"]

    principals {
      type        = "AWS"
      identifiers = ["arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:root"]
    }
  }
}

resource "aws_kms_key" "secret" {
  description             = "Encrypts the ${var.name_prefix} database credentials in Secrets Manager"
  enable_key_rotation     = true
  deletion_window_in_days = 7
  policy                  = data.aws_iam_policy_document.secret_kms.json
}

resource "aws_kms_alias" "secret" {
  name          = "alias/${var.name_prefix}-db-secret"
  target_key_id = aws_kms_key.secret.key_id
}

# Letters and digits only: the password is placed in a connection URL and an
# environment file, so characters with special meaning there are avoided. A
# 32-character random alphanumeric password has about 190 bits of entropy.
resource "random_password" "master" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "db" {
  #checkov:skip=CKV2_AWS_57:Automatic rotation needs a rotation function (a Lambda) that is out of scope for this project. The password is random, never leaves AWS and the deployment pipeline, and can be rotated by changing the random_password resource and applying. See SECURITY.md.
  name_prefix             = "${var.name_prefix}-db-credentials-"
  description             = "PostgreSQL credentials and connection details for ${var.name_prefix}"
  kms_key_id              = aws_kms_key.secret.arn
  recovery_window_in_days = var.secret_recovery_window_days
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id

  secret_string = jsonencode({
    username = var.db_username
    password = random_password.master.result
    host     = aws_db_instance.this.address
    port     = aws_db_instance.this.port
    dbname   = var.db_name
  })
}

# ------------------------------ Networking -----------------------------------

resource "aws_db_subnet_group" "this" {
  name_prefix = "${var.name_prefix}-"
  description = "Private subnets for the ${var.name_prefix} database"
  subnet_ids  = var.private_subnet_ids

  tags = {
    Name = "${var.name_prefix}-db-subnets"
  }
}

# ------------------------------ Parameters -----------------------------------

resource "aws_db_parameter_group" "this" {
  name_prefix = "${var.name_prefix}-pg-"
  family      = var.parameter_group_family
  description = "SokoPrice PostgreSQL settings: TLS required, connection and slow-query logging"

  parameter {
    name         = "rds.force_ssl"
    value        = "1"
    apply_method = "immediate"
  }

  parameter {
    name         = "log_connections"
    value        = "1"
    apply_method = "immediate"
  }

  parameter {
    name         = "log_disconnections"
    value        = "1"
    apply_method = "immediate"
  }

  parameter {
    name         = "log_statement"
    value        = "ddl"
    apply_method = "immediate"
  }

  parameter {
    name         = "log_min_duration_statement"
    value        = "1000"
    apply_method = "immediate"
  }

  lifecycle {
    create_before_destroy = true
  }
}

# --------------------------- Enhanced monitoring -----------------------------

data "aws_iam_policy_document" "monitoring_assume_role" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["monitoring.rds.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "monitoring" {
  name_prefix        = "${var.name_prefix}-rds-monitoring-"
  assume_role_policy = data.aws_iam_policy_document.monitoring_assume_role.json
}

resource "aws_iam_role_policy_attachment" "monitoring" {
  role       = aws_iam_role.monitoring.name
  policy_arn = "arn:${data.aws_partition.current.partition}:iam::aws:policy/service-role/AmazonRDSEnhancedMonitoringRole"
}

# ------------------------------- Database ------------------------------------

resource "aws_db_instance" "this" {
  #checkov:skip=CKV_AWS_157:Multi-AZ doubles the cost, so it is a variable that is off for dev and on for prod (see environments/prod.tfvars.example).
  #checkov:skip=CKV_AWS_293:Deletion protection is a variable that is off for dev so that terraform destroy can remove the lab environment, and on for prod (see environments/prod.tfvars.example).
  #checkov:skip=CKV_AWS_353:Performance Insights is not offered on the small instance class used for this project. Enhanced monitoring and CloudWatch metrics are enabled instead.
  #checkov:skip=CKV_AWS_354:Same reason as CKV_AWS_353: Performance Insights is not enabled.
  identifier_prefix = "${var.name_prefix}-"

  engine         = "postgres"
  engine_version = var.engine_version
  instance_class = var.instance_class

  allocated_storage = var.allocated_storage
  storage_type      = "gp3"
  storage_encrypted = true

  db_name  = var.db_name
  username = var.db_username
  password = random_password.master.result
  port     = 5432

  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [var.security_group_id]
  parameter_group_name   = aws_db_parameter_group.this.name
  publicly_accessible    = false
  multi_az               = var.multi_az

  backup_retention_period = var.backup_retention_days
  backup_window           = "01:00-02:00"
  maintenance_window      = "Sun:02:30-Sun:03:30"
  copy_tags_to_snapshot   = true

  auto_minor_version_upgrade = true
  apply_immediately          = var.apply_immediately

  iam_database_authentication_enabled = true
  enabled_cloudwatch_logs_exports     = ["postgresql", "upgrade"]

  monitoring_interval = 60
  monitoring_role_arn = aws_iam_role.monitoring.arn

  deletion_protection       = var.deletion_protection
  skip_final_snapshot       = var.skip_final_snapshot
  final_snapshot_identifier = var.skip_final_snapshot ? null : "${var.name_prefix}-final-snapshot"

  tags = {
    Name = "${var.name_prefix}-db"
  }

  # Minor versions are upgraded by AWS (auto_minor_version_upgrade); Terraform
  # must not try to move the engine back.
  lifecycle {
    ignore_changes = [engine_version]
  }
}
