# -----------------------------------------------------------------------------
# Example values. Copy this file to terraform.tfvars and edit it:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is git-ignored. It contains no secrets, but it does contain
# your own IP address, which does not belong in a public repository.
# -----------------------------------------------------------------------------

# Region closest to your users (an opt-in region such as af-south-1 must first
# be enabled in your AWS account settings).
aws_region = "eu-north-1"

project_name = "sokoprice"
environment  = "dev"

# Your public IP address with /32. Find it with:  curl https://checkip.amazonaws.com
# 0.0.0.0/0 is rejected on purpose. Only the bastion host accepts SSH, and only
# from these addresses.
admin_cidrs = ["203.0.113.25/32"]

# The text of your PUBLIC key file (never the private key):
#   ssh-keygen -t ed25519 -f ~/.ssh/sokoprice -C "sokoprice"
#   cat ~/.ssh/sokoprice.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLE sokoprice"

# The GitHub repository whose workflow may deploy (owner/name).
github_repository = "jessewalu/sokoprice-formative1"

# Optional: e-mail address for alarm notifications (AWS sends a confirmation link).
# alert_email = "you@example.com"

# Optional: serve HTTPS. Needs a domain name and a certificate from AWS
# Certificate Manager in the SAME region (see README, "HTTPS").
# certificate_arn = "arn:aws:acm:eu-north-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Only if your AWS account already has a GitHub OIDC identity provider
# (an account can hold only one):
# create_github_oidc_provider = false

# Optional overrides (defaults are shown in variables.tf).
# instance_type         = "t3.micro"
# bastion_instance_type = "t3.micro"
# db_instance_class     = "db.t3.micro"
# app_port              = 80
