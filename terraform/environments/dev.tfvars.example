# Development environment. Use with:
#   terraform plan -var-file=environments/dev.tfvars
# (copy this file to environments/dev.tfvars first; it is git-ignored)

aws_region  = "eu-west-1"
environment = "dev"

vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.1.0/24", "10.20.2.0/24"]

admin_cidrs    = ["203.0.113.25/32"]
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLE sokoprice"

# Cheapest settings for development.
instance_type              = "t3.micro"
root_volume_size           = 20
enable_detailed_monitoring = false
flow_log_retention_days    = 30
