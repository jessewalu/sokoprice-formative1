# Development environment. Use with:
#   terraform plan -var-file=environments/dev.tfvars
# (copy this file to environments/dev.tfvars first; it is git-ignored)
#
# Cheapest settings: small instances, a single-zone database, short backups, and
# everything can be removed again with `terraform destroy`.

aws_region  = "eu-north-1"
environment = "dev"

admin_cidrs    = ["203.0.113.25/32"]
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLE sokoprice"

instance_type         = "t3.micro"
bastion_instance_type = "t3.micro"
db_instance_class     = "db.t3.micro"

db_multi_az              = false
db_backup_retention_days = 1
db_deletion_protection   = false
db_skip_final_snapshot   = true
flow_log_retention_days  = 30
log_retention_days       = 30
