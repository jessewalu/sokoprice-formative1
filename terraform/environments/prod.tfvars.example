# Production environment. Use with:
#   terraform plan -var-file=environments/prod.tfvars
# (copy this file to environments/prod.tfvars first; it is git-ignored)
#
# A different CIDR range keeps prod and dev networks apart (they can be peered
# later without overlapping addresses). Protection is switched on: the database
# and load balancer cannot be deleted by accident, and the database is
# duplicated across two availability zones.

aws_region  = "eu-north-1"
environment = "prod"

vpc_cidr             = "10.30.0.0/16"
public_subnet_cidrs  = ["10.30.1.0/24", "10.30.2.0/24"]
private_subnet_cidrs = ["10.30.11.0/24", "10.30.12.0/24"]

admin_cidrs    = ["203.0.113.25/32"]
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLE sokoprice"

# More headroom and detailed metrics.
instance_type              = "t3.small"
root_volume_size           = 30
enable_detailed_monitoring = true

db_instance_class              = "db.t3.small"
db_multi_az                    = true
db_backup_retention_days       = 7
db_deletion_protection         = true
db_skip_final_snapshot         = false
db_secret_recovery_window_days = 7
ecr_force_delete               = false
alb_deletion_protection        = true

# Serve HTTPS in production (certificate for your domain, same region).
# certificate_arn = "arn:aws:acm:eu-north-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

alert_email = "alerts@example.com"

extra_tags = {
  Owner = "sokoprice-team"
}
