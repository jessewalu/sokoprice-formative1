# Keep the Docker build context small and free of secrets.
# Only requirements.txt, app/, data/, scripts/ and run.py are needed by the image.

# Version control and CI
.git
.gitignore
.gitattributes
.github

# Secrets and local configuration (never bake these into an image)
.env
.env.*
!.env.example
*.pem
*.key

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
test-results.xml

# Editors and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Not needed at run time
tests/
docs/
*.md
LICENSE
docker-compose*.yml
Dockerfile
.dockerignore
requirements-dev.txt
ruff.toml
pytest.ini
